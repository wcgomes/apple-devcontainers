{
  "name": "reference-multiplatform",
  // Team sample: multi-platform shape. On Apple container, docker-* features and
  // privileged/device runArgs warn-skip; remaining surface (image, node feature,
  // NET_ADMIN, mounts, postCreate, ports, vscode) can still up. See ADR 0003.
  "image": "mcr.microsoft.com/dotnet/sdk:8.0",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": true
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "runArgs": [
    "--privileged",
    "--cap-add=NET_ADMIN",
    "--device=/dev/net/tun:/dev/net/tun",
    "--init"
  ],
  "mounts": [
    "source=${localWorkspaceFolder}/.cache,target=/home/vscode/.cache,type=bind"
  ],
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [5000, 5001],
  "postCreateCommand": "dotnet --info",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp"
      ]
    }
  }
}
